{
  "manifest_version": 3,
  "name": "wikiPhidia",
  "version": "1.6.7",
  "description": "Read anything on the web, pick up new words with their meaning and sentence, and send them straight into wikiPhidia's Vocabulary.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "wikiPhidia",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [ "storage", "contextMenus", "tabs", "scripting" ],
  "host_permissions": [ "<all_urls>", "https://translate.googleapis.com/*", "https://api.mymemory.translated.net/*", "https://raw.githubusercontent.com/*", "https://phillipxnguyen.github.io/*", "https://www.youtube.com/*", "https://m.youtube.com/*" ],
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "exclude_matches": [ "https://phillipxnguyen.github.io/*" ],
      "js": [ "vendor/pinyin-pro.js", "reader.js" ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [ "https://phillipxnguyen.github.io/*", "http://localhost/*", "http://127.0.0.1/*", "file:///*" ],
      "include_globs": [ "*wikiPhidia*", "*wikiphidia*", "http://localhost*", "http://127.0.0.1*" ],
      "js": [ "bridge.js" ],
      "run_at": "document_idle"
    }
  ]
}
